<%- include('partials/header') %>

<div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
    <div class="col-lg-8 px-0">
        <h1 class="display-4 fst-italic">Welcome to the E-Procurement System</h1>
        <p class="lead my-3">Browse and apply for the latest government vacancies and tenders. Stay updated with public notices.</p>
    </div>
</div>

<h2 class="mb-4">Current Vacancies</h2>

<div class="row g-4">
    <% if (vacancies.length > 0) { %>
        <% vacancies.forEach(vacancy => { %>
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><%= vacancy.title %></h5>
                        <h6 class="card-subtitle mb-2 text-muted"><%= vacancy.department %></h6>
                        <p class="card-text"><%= vacancy.description.substring(0, 150) %>...</p>
                        
                        <div class="mt-auto">
                            <p class="mb-2">
                                <small class="text-danger">
                                    Deadline: <%= new Date(vacancy.deadline).toLocaleDateString() %>
                                </small>
                            </p>
                            <a href="/vacancy/<%= vacancy._id %>" class="btn btn-primary">View Details & Apply</a>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                There are no active vacancies at this time. Please check back later.
            </div>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Notices</h2>
    <a href="/admin/notice/new" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Post New Notice
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Posted On</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (notices.length > 0) { %>
                        <% notices.forEach(notice => { %>
                            <tr>
                                <td><%= notice.title %></td>
                                <td><%= new Date(notice.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/admin/notice/edit/<%= notice._id %>" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-fill"></i> Edit
                                        </a>
                                        <form action="/admin/notice/delete/<%= notice._id %>" method="POST" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to delete this notice?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash-fill"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="3" class="text-center">No notices found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
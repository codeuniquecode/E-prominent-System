<%- include('partials/header') %>

<h1 class="mb-4">Admin Dashboard</h1>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-people-fill fs-1"></i>
                <h3 class="card-title"><%= stats.users %></h3>
                <p class="card-text">Total Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-briefcase-fill fs-1"></i>
                <h3 class="card-title"><%= stats.vacancies %></h3>
                <p class="card-text">Total Vacancies</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-text-fill fs-1"></i>
                <h3 class="card-title"><%= stats.notices %></h3>
                <p class="card-text">Total Notices</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-clock-history fs-1"></i>
                <h3 class="card-title"><%= stats.pending %></h3>
                <p class="card-text">Pending Applications</p>
            </div>
        </div>
    </div>
</div>

<!-- Admin Actions (Updated) -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center p-4 d-flex flex-column">
                <i class="bi bi-briefcase-fill fs-1 text-success"></i>
                <h4 class="card-title mt-2">Manage Vacancies</h4>
                <p>Create, view, edit, and delete job vacancies.</p>
                <div class="mt-auto">
                    <a href="/admin/manage/vacancies" class="btn btn-success me-2">View All</a>
                    <a href="/admin/vacancy/new" class="btn btn-outline-success">Post New</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center p-4 d-flex flex-column">
                <i class="bi bi-file-earmark-text-fill fs-1 text-info"></i>
                <h4 class="card-title mt-2">Manage Notices</h4>
                <p>Create, publish, edit, and delete public notices.</p>
                <div class="mt-auto">
                    <a href="/admin/manage/notices" class="btn btn-info me-2">View All</a>
                    <a href="/admin/notice/new" class="btn btn-outline-info">Post New</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-journal-check fs-1 text-primary"></i>
                <h4 class="card-title mt-2">Review Applications</h4>
                <p>Review, approve, or reject applications submitted by users.</p>
                <a href="/admin/applications" class="btn btn-primary">View All Applications</a>
            </div>
        </div>
    </div>
</div>


<%- include('partials/footer') %>